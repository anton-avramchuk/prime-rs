// File generated by `cargo xtask gen-icons` from the PrimeNG icons; do not edit manually.
// Icons are added only when the feature of the same name is enabled.

#[cfg(feature = "check")]
icon!(CheckIcon, ["M4.8 11.5 L1 2"]);

#[cfg(feature = "spinner")]
icon!(SpinnerIcon, ["M1 1", "M2 2"]);

/// All icons in a row (for demos and size measurements).
#[cfg(feature = "all-icons")]
#[::leptos::component]
pub fn AllIcons() -> impl ::leptos::prelude::IntoView {
    use ::leptos::prelude::*;
    [
        view! { <crate::BlankIcon /> }.into_any(),
        view! { <CheckIcon /> }.into_any(),
        view! { <SpinnerIcon /> }.into_any(),
    ]
    .into_iter()
    .collect_view()
}
